{
  "name": "vue-project",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "npm@11.6.2",
  "engines": {
    "node": ">=24.15.0 <25",
    "npm": "^11.6.2"
  },
  "scripts": {
    "dev": "vite",
    "build": "npm run type-check && npm run build-only",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --cache --max-warnings=0",
    "lint:fix": "eslint . --fix --cache",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "npm run type-check && npm run lint && npm run format:check && npm run build-only"
  },
  "dependencies": {
    "@fontsource-variable/wix-madefor-display": "5.2.8",
    "@mdi/js": "7.4.47",
    "axios": "1.18.1",
    "pinia": "3.0.4",
    "vue": "3.5.39",
    "vue-router": "5.1.0",
    "vuetify": "~4.1.0"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.4",
    "@types/node": "^24.13.3",
    "@vitejs/plugin-vue": "6.0.7",
    "@vitest/eslint-plugin": "1.6.23",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.2.7",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.7.0",
    "eslint-plugin-vue": "10.9.2",
    "jiti": "2.7.0",
    "jsdom": "29.1.1",
    "msw": "2.15.0",
    "prettier": "3.9.5",
    "sass": "^1.102.0",
    "typescript": "5.9.3",
    "vite": "8.1.4",
    "vite-plugin-vuetify": "2.1.3",
    "vite-svg-loader": "5.1.1",
    "vitest": "4.1.10",
    "vue-tsc": "3.3.7"
  }
}
