    "axios": "1.20.0",
    "echarts": "6.1.0",
    "grid-layout-plus": "1.1.1",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-echarts": "8.3.0",
    "vue-router": "5.3.1",
    "vuetify": "~4.2.1"
  },
  "devDependencies": {
    "@tsconfig/node24": "24.0.5",
    "@types/node": "^24.13.5",
    "@vitejs/plugin-vue": "6.0.9",
    "@vitest/eslint-plugin": "1.6.27",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "@vue/test-utils": "2.5.1",
    "@vue/tsconfig": "0.9.1",
    "eslint": "10.10.0",
    "eslint-plugin-vue": "10.11.0",
    "jiti": "2.7.0",
    "jsdom": "30.1.0",
    "msw": "2.15.0",
    "prettier": "3.9.7",
    "sass": "^1.104.1",
    "typescript": "6.0.3",
    "vite": "^8.3.0",
    "vite-plugin-vuetify": "2.1.3",
    "vite-svg-loader": "5.1.3",
    "vitest": "5.0.1",
    "vue-tsc": "3.3.11"
  }
